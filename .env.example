# local | production
NOVEL_ENV=local
# email | username. Choose once per deployment; email remains the safe default.
NOVEL_AUTH_MODE=email
NOVEL_PUBLIC_URL=http://127.0.0.1:8000
NOVEL_DATABASE_URL=sqlite:///data/novel.sqlite3
NOVEL_JOB_WORKERS=1
NOVEL_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
NOVEL_TRUSTED_HOSTS=127.0.0.1,localhost

# Production must use HTTPS and a fixed public hostname.
NOVEL_COOKIE_SECURE=0
NOVEL_ALLOWED_PROVIDER_HOSTS=api.openai.com,api.anthropic.com

# SMTP is used only when NOVEL_AUTH_MODE=email. Mailpit defaults are convenient locally.
NOVEL_SMTP_HOST=127.0.0.1
NOVEL_SMTP_PORT=1025
NOVEL_SMTP_USERNAME=
NOVEL_SMTP_PASSWORD=
NOVEL_SMTP_USE_TLS=0
NOVEL_SMTP_FROM=novel@example.test

# MySQL production example:
# NOVEL_DATABASE_URL=mysql+pymysql://novelapp:change-me@127.0.0.1:3306/novel_auto_write?charset=utf8mb4
