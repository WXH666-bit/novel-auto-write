{
  "name": "novel-auto-write-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.app.json && vite build",
    "preview": "vite preview",
    "lint": "tsc --noEmit -p tsconfig.app.json",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "test:types": "tsc --noEmit -p tsconfig.tests.json && tsc --noEmit -p tsconfig.e2e.json",
    "test:e2e": "playwright test --config playwright.config.ts",
    "test:e2e:list": "playwright test --config playwright.config.ts --list"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.59.16",
    "@xyflow/react": "^12.11.6",
    "lucide-react": "^0.468.0",
    "motion": "^13.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.4.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^26.1.0",
    "typescript": "^5.6.3",
    "vite": "^6.0.5",
    "vitest": "^4.1.11"
  }
}
